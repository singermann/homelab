# Ziel: /etc/systemd/system/homelab-health.service
# Voraussetzung: useradd --system --no-create-home --shell /usr/sbin/nologin homelab-health
[Unit]
Description=Homelab Systemcheck (Platte, RAM, Dienste)
Documentation=https://github.com/singermann/homelab

[Service]
Type=oneshot
ExecStart=/usr/local/bin/homelab-health
Environment=THRESHOLD=80

# Härtung: eigener Systembenutzer ohne Login, darf nichts schreiben.
# Hinweis: DynamicUser=yes funktioniert hier nicht – D-Bus weist den
# temporären Benutzer ab ("Transport endpoint is not connected").
User=homelab-health
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
